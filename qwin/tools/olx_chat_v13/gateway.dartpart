  Future<Map<String,dynamic>> uploadChatPhoto(String source,String threadId,Uint8List data)async{
    if(!{'olx','qwin'}.contains(source))throw StateError('Invalid chat source');
    if(uploadUrl.isEmpty)throw StateError('Chat photo storage unavailable');
    final jpeg=data.length>=3&&data[0]==0xff&&data[1]==0xd8&&data[2]==0xff;
    final png=data.length>=8&&data[0]==0x89&&data[1]==0x50&&data[2]==0x4e;
    if((!jpeg&&!png)||data.length>4500000)throw StateError('JPEG/PNG up to 4.5 MB');
    await refreshSession();
    if(_jwt==null||userId==null)throw StateError('Sign in first');
    final base=uploadUrl.replaceFirst(RegExp(r'/+$'),'');
    final uri=Uri.parse('$base/chat_photo').replace(
      queryParameters:{'source':source,'thread_id':threadId});
    final response=await _http.post(uri,headers:{
      'Authorization':'Bearer $_jwt',
      'Content-Type':jpeg?'image/jpeg':'image/png',
    },body:data).timeout(const Duration(seconds:75));
    final value=_decode(response);
    if(value is! Map||value['media_id']==null||value['url']==null)
      throw StateError('Chat photo upload failed');
    return Map<String,dynamic>.from(value);
  }
