class _OlxAdvertThumbnail extends StatelessWidget{
  final String? url;
  const _OlxAdvertThumbnail({this.url});
  @override Widget build(BuildContext context){
    final uri=Uri.tryParse(url??'');
    if(uri==null||uri.scheme!='https'||uri.host.isEmpty){
      return const CircleAvatar(backgroundColor:Color(0xFFE4F1FF),
        child:Icon(Icons.image_outlined,color:Color(0xFF0B50CD)));
    }
    return ClipRRect(borderRadius:BorderRadius.circular(12),
      child:SizedBox(width:49,height:49,child:Image.network(uri.toString(),
        fit:BoxFit.cover,
        errorBuilder:(_,__,___)=>const ColoredBox(
          color:Color(0xFFE4F1FF),child:Icon(Icons.image_outlined)))));
  }
}

