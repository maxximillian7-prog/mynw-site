Widget _integrationScreen(){
    final signedIn=widget.store.neon!=null&&!widget.store.isGuest;
    final olxAvailable=widget.store.neon?.olxEnabled==true;
    return Scaffold(
      appBar:AppBar(title:Text(widget.locale=='ru'?'Интеграции':
        widget.locale=='pt'?'Integrações':'Integrations')),
      body:ValueListenableBuilder<int>(
        valueListenable:_integrationRevision,
        builder:(context,revision,_)=>ListView(
          padding:const EdgeInsets.all(16),children:[
            Card(child:Padding(
              padding:const EdgeInsets.all(17),
              child:Column(crossAxisAlignment:CrossAxisAlignment.stretch,children:[
                Row(children:[
                  const Icon(Icons.storefront_rounded,color:QwinColors.green),
                  const SizedBox(width:10),
                  const Expanded(child:Text('OLX Portugal',
                    style:TextStyle(fontSize:18,fontWeight:FontWeight.w900))),
                ]),
                const SizedBox(height:12),
                Text(!signedIn
                  ?QwinStrings.t(widget.locale,'signInRequired')
                  :!olxAvailable
                    ?(widget.locale=='ru'?'Подключение OLX недоступно в этой сборке':
                      widget.locale=='pt'?'Ligação OLX indisponível nesta versão':
                      'OLX connection is unavailable in this build')
                    :olxInfo.isNotEmpty?olxInfo:
                      QwinStrings.t(widget.locale,'olxNotConnected')),
                const SizedBox(height:12),
                if(signedIn&&olxAvailable)...[
                  if(olxConnected)
                    OutlinedButton.icon(
                      onPressed:olxBusy?null:_olxDisconnect,
                      icon:const Icon(Icons.link_off_rounded),
                      label:Text(QwinStrings.t(widget.locale,'disconnectOlx')))
                  else
                    FilledButton.tonalIcon(
                      onPressed:olxBusy?null:_olxConnect,
                      icon:const Icon(Icons.link_rounded),
                      label:Text(QwinStrings.t(widget.locale,'connectOlxAccount'))),
                  if(olxPending&&!olxConnected)
                    OutlinedButton.icon(
                      onPressed:olxBusy?null:_olxFinish,
                      icon:const Icon(Icons.verified_outlined),
                      label:Text(QwinStrings.t(widget.locale,'finishOlx'))),
                  const SizedBox(height:7),
                  TextButton.icon(
                    onPressed:olxBusy||olxChecking?null:_olxStatus,
                    icon:const Icon(Icons.refresh_rounded),
                    label:Text(QwinStrings.t(widget.locale,'refreshStatus'))),
                ],
                if(olxBusy||olxChecking)
                  const LinearProgressIndicator(minHeight:2),
              ]))),
          ])));
  }

  